# Example Android keystore signing properties for Greyskull LP
# Copy this file to 'android/key.properties' and fill in your actual private credentials.
# NEVER commit 'key.properties' or keystore files (.jks, .keystore) to git!
storePassword=your_keystore_password
keyPassword=your_key_password
keyAlias=upload
storeFile=/absolute/path/to/upload-keystore.jks
